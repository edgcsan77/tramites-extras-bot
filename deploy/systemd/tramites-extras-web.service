[Unit]
Description=Tramites Extras Web
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=tramites
Group=tramites
WorkingDirectory=/opt/tramites-extras-bot
EnvironmentFile=/opt/tramites-extras-bot/.env
ExecStart=/opt/tramites-extras-bot/.venv/bin/gunicorn app.main:app --worker-class uvicorn.workers.UvicornWorker --bind 127.0.0.1:8110 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

[Unit]
Description=Tramites Extras Worker %i
After=network.target redis-server.service postgresql.service

[Service]
Type=simple
User=tramites
Group=tramites
WorkingDirectory=/opt/tramites-extras-bot
EnvironmentFile=/opt/tramites-extras-bot/.env
ExecStart=/opt/tramites-extras-bot/.venv/bin/rq worker extras_cfe extras_renapo --url ${REDIS_URL}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
